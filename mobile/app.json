{
  "expo": {
    "name": "Floraly",
    "slug": "floraly",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F1EEE6"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.floraly.app",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "NSPhotoLibraryUsageDescription": "Floraly needs photo access to share nature memories.",
        "NSCameraUsageDescription": "Floraly can use the camera to capture outdoor photos."
      }
    },
    "android": {
      "package": "com.floraly.app",
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "backgroundColor": "#F1EEE6",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-image",
      "expo-audio"
    ]
  }
}
